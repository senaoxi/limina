{
  // Shared legacy test-check base. Declaration test leaves use explicit *.dts.json configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "isolatedDeclarations": false,
    "jsx": "preserve",
    "lib": [
      "ES2023",
      "ES2024.Collection",
      "ES2024.Object",
      "ES2024.Promise",
      "ES2025.Collection",
      "ES2025.Iterator",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "stripInternal": false
  },
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**"]
}
