{
  "name": "@limina/monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senaoxi/limina.git"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "prepare": "husky",
    "hooks:install": "husky",
    "commit:check": "node packages/gates/src/commit/message.ts",
    "check": "limina check",
    "typecheck": "limina check typecheck",
    "build": "pnpm run build:tools && pnpm --filter limina run build && pnpm --filter limina-migrate run build",
    "build:tools": "pnpm --filter @limina/gates run build && pnpm --filter @limina/build-tools run build",
    "build:watch": "pnpm run build:tools && pnpm --parallel --filter limina --filter limina-migrate run dev",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:tooling && pnpm run test:integration",
    "test:unit": "pnpm --filter limina run test:unit && pnpm --filter limina-migrate run test:unit",
    "test:integration": "pnpm --filter limina run test:integration && pnpm --filter limina-migrate run test:integration",
    "test:tooling": "pnpm --filter @limina/gates test && node --import tsx --test scripts/release/*.spec.ts scripts/docs/*.spec.ts scripts/git/*.spec.ts",
    "test:smoke": "pnpm --dir smoke test",
    "smoke": "pnpm run build && pnpm run test:smoke",
    "docs:dev": "pnpm --dir docs run docs:dev",
    "docs:build": "pnpm --dir docs run docs:build",
    "docs:privacy": "node packages/gates/src/privacy/check.ts",
    "docs:preview": "pnpm --dir docs run docs:preview",
    "format": "prettier --write --cache .",
    "format:check": "limina check format",
    "format:write": "pnpm run format",
    "lint": "eslint . --fix --cache --concurrency auto --config ./eslint.config.mjs && pnpm -r --parallel run lint",
    "lint:check": "limina check lint",
    "lint:fix": "pnpm run lint",
    "lint:packages": "limina check packages",
    "release": "tsx scripts/release.ts",
    "release:check-tag": "limina check release-tag",
    "changelog": "tsx scripts/changelog.ts",
    "changelog:preview": "tsx scripts/changelog.ts --dry-run",
    "migration": "limina-migrate",
    "clean": "pnpm -r run clean && del-cli .tsbuild .limina .smoke .eslintcache",
    "gates:check": "node packages/gates/src/commit/staged.ts",
    "gates:staged": "node packages/gates/src/commit/staged.ts --staged"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:lint",
    "@commitlint/config-conventional": "catalog:lint",
    "@types/node": "catalog:dev",
    "@xterm/headless": "catalog:dev",
    "yaml": "catalog:dev",
    "logaria": "catalog:dev",
    "eslint": "catalog:lint",
    "husky": "catalog:dev",
    "typescript": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "tsx": "catalog:dev",
    "prettier": "catalog:format",
    "prettier-plugin-organize-imports": "catalog:format",
    "del-cli": "catalog:dev",
    "limina": "workspace:*",
    "limina-migrate": "workspace:*",
    "@limina/gates": "workspace:*"
  }
}
