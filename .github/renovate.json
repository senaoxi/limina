{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Taipei",
  "dependencyDashboard": true,
  "automerge": false,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1440 minutes",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    { "matchManagers": ["github-actions"], "pinDigests": true },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    },
    {
      "description": "Checker upgrades require review against exact supported tuples and peer contracts",
      "matchDepNames": [
        "typescript",
        "vue-tsc",
        "@typescript/native-preview",
        "@types/node",
        "@astrojs/check",
        "svelte2tsx",
        "svelte-check",
        "astro",
        "astro-v7-min",
        "svelte-v4-min",
        "svelte-check-v4-min"
      ],
      "groupName": "checker compatibility toolchain",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Astro compatibility floor frozen until the supported minimum changes",
      "matchManagers": ["npm"],
      "matchDepNames": ["astro-v7-min"],
      "enabled": false
    },
    {
      "description": "Review exact Astro baseline upgrades within the supported major",
      "matchManagers": ["npm"],
      "matchDepNames": ["astro"],
      "allowedVersions": ">=7.0.0 <8.0.0",
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": ["vite"],
      "matchCurrentVersion": ">=5.0.0 <6.0.0",
      "allowedVersions": ">=5.0.0 <6.0.0"
    },
    {
      "matchDepTypes": ["packageManager"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "eslint",
        "@eslint/*",
        "typescript-eslint",
        "@typescript-eslint/*",
        "eslint-*"
      ],
      "groupName": "lint toolchain",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchPackageNames": ["prettier", "prettier-plugin-*"],
      "groupName": "format tooling",
      "matchUpdateTypes": ["minor", "patch"]
    },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true }
  ]
}
